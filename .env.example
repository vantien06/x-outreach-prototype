# ---- Mode -------------------------------------------------------------
# local  = single operator, all keys are yours.
# hosted = multi-user: the host's X app and LLM key are used, users only sign in with X.
APP_MODE=local
# true = no X or LLM calls at all: sample (fictional) data, simulated sends and replies.
DRY_RUN=true
# Public URL of this app (no trailing slash). Used for the OAuth callback.
BASE_URL=http://127.0.0.1:8000

# ---- X (only needed when DRY_RUN=false) --------------------------------
# From your X developer app (OAuth 2.0, type "Web App"). Register the callback
# URL exactly as: <BASE_URL>/auth/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---- LLM (only needed when DRY_RUN=false) ------------------------------
ANTHROPIC_API_KEY=

# ---- Secrets ------------------------------------------------------------
# Fernet key that encrypts stored X tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Local mode: leave empty and one is generated into data/secret.key.
# Hosted mode: required.
TOKEN_ENCRYPTION_KEY=

# ---- Storage ------------------------------------------------------------
# On Railway, point this at the mounted volume, e.g. /data/outreach.db
DATABASE_PATH=data/outreach.db

# ---- Limits -------------------------------------------------------------
# Max DMs sent per connected account per UTC day.
DAILY_SEND_CAP=20
# Minimum seconds between two sends from the same account.
SEND_SPACING_SECONDS=90
# Max candidates scored per account per UTC day (0 = unlimited).
DAILY_CANDIDATE_CAP=80
# Hosted only: comma-separated X handles allowed to sign in. Empty = nobody.
ALLOWED_HANDLES=
# Estimated total spend (USD, X API + LLM) after which discovery, drafting and
# sending lock for everyone. 0 = no ceiling.
GLOBAL_BUDGET_USD=0

# ---- Discovery budget (optional; defaults shown) -------------------------
# Segment search: number of queries, posts read on the first page of each, and
# the most posts one campaign may read in total. Every returned post is billed.
MAX_QUERIES=5
POSTS_PER_QUERY=40
MAX_POSTS_PER_CAMPAIGN=200
# People scored per campaign, at most.
MAX_CANDIDATES_PER_CAMPAIGN=30
# Seed campaigns: accounts read from the seeds' following lists, and recent
# posts read per person before scoring.
SEED_FOLLOWING_LIMIT=100
SEED_POSTS_PER_CANDIDATE=5

# ---- Reply tracking (optional; defaults shown) ----------------------------
# The tool checks each sent conversation for replies through X's chat-history
# endpoint. X allowed 100 reads per 15 minutes and 10,000 per 24 hours per user
# when measured; these stay well under both.
CHAT_READS_PER_15MIN=60
CHAT_READS_PER_DAY=6000
CHAT_READS_PER_TICK=8
